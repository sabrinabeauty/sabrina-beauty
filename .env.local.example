# Required. Admin login will not work without this set.
# Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value per environment (local vs production) and never commit it.
SESSION_SECRET=

# Required. Postgres (Neon) connection strings — pull these automatically instead
# of filling them in by hand:
#   vercel link
#   vercel env pull .env.local --environment=development
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# Required for image uploads (products/gallery). Also pulled via `vercel env pull` above.
BLOB_READ_WRITE_TOKEN=

# Required for new-booking email alerts (lib/email.ts). Free tier, resend.com —
# create an API key with "Sending access" and paste it here. Without this set,
# bookings still succeed; the owner just won't be emailed (see the try/catch in
# app/api/bookings/route.ts — a missing key logs an error, it never blocks a booking).
RESEND_API_KEY=

# Required for the daily booking-reminder cron (app/api/cron/daily-reminder,
# scheduled in vercel.json). Vercel automatically sends this as a Bearer
# token on its own cron-triggered requests when it's set as an env var —
# generate a random value (e.g. `openssl rand -hex 32`) and set it in
# Vercel's dashboard (Production only; cron doesn't run against Preview).
# Not needed locally — there's nothing to schedule outside Vercel.
CRON_SECRET=

# Required to run `npm test`. Points at a SEPARATE database (sabrina-beauty-test-db)
# dedicated to tests, which TRUNCATE all tables — never point this at the real
# database. Also pulled automatically via `vercel env pull` above.
TEST_POSTGRES_URL=
